{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Firmware: build FRDM-MCXN236",
            "type": "process",
            "command": "/home/thanhduoc/zephyrproject/.venv/bin/python",
            "args": [
                "-m",
                "west",
                "build",
                "--pristine=auto",
                "-b",
                "frdm_mcxn236/mcxn236",
                "${workspaceFolder}",
                "-d",
                "${workspaceFolder}/build"
            ],
            "options": {
                "cwd": "${workspaceFolder}/.."
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ]
        }
    ]
}
